#
# mod-lan configuration
#

[worldserver]

###################################################################################################
# GENERAL
#
#    Lan.Enable
#        Description: Turns every mod-lan feature on or off.
#        Default:     1
Lan.Enable = 1

#    Lan.SkillGain
#        Description: Skill points gained per skill-up, for professions (crafting, gathering, fishing),
#                     weapon skills and defense. Overrides SkillGain.* in worldserver.conf.
#                     0 keeps the worldserver.conf values.
#        Default:     4 (4 times as fast)
Lan.SkillGain = 4

#    Lan.TalentRate
#        Description: Talent points per level from level 10 (overrides Rate.Talent). 0 keeps worldserver.conf.
#        Default:     3
Lan.TalentRate = 3

#    Lan.NoResurrectionSickness
#        Description: Nobody gets resurrection sickness (sets Death.SicknessLevel out of reach).
#        Default:     1
Lan.NoResurrectionSickness = 1

#    Lan.AlwaysRested
#        Description: Real players are always fully rested: the rested bonus (double experience from kills)
#                     is topped up to the maximum on login, on level-up and before every experience gain.
#        Default:     1
Lan.AlwaysRested = 1

#    Lan.StartZones.SpawnMultiplier
#        Description: Enemies in the eight starting zones (Elwynn Forest, Dun Morogh, Tirisfal Glades, Durotar,
#                     Mulgore, Teldrassil, Azuremyst Isle, Eversong Woods). Every hostile or neutral normal mob
#                     up to level 15 gets copies a few yards away: 3 means three times as many. Rares, elites,
#                     critters, NPCs with services and pooled or scripted spawns stay single. 1 turns it off.
#        Default:     3
Lan.StartZones.SpawnMultiplier = 3

#    Lan.HearthstoneCooldown
#        Description: Cooldown of the Hearthstone in seconds. 0 keeps the normal 60 minutes.
#                     Game clients show the new time once their cache (the Cache folder) is cleared.
#        Default:     300 (5 minutes)
Lan.HearthstoneCooldown = 300

#    Lan.StartGold
#        Description: Gold new characters start with. Overrides StartPlayerMoney.
#        Default:     150
Lan.StartGold = 150

#    Lan.SoloRaids
#        Description: Raids can be entered without a raid group (sets Instance.IgnoreRaid).
#        Default:     1
Lan.SoloRaids = 1

###################################################################################################
# SPELL LEARNING
#
#    Lan.AutoLearn.ClassSpells
#        Description: Learn all class trainer spells for free on login and level-up.
#        Default:     1
Lan.AutoLearn.ClassSpells = 1

#    Lan.AutoLearn.QuestSpells
#        Description: Learn the spells (and the shaman totems) that class quests give on login and level-up.
#        Default:     1
Lan.AutoLearn.QuestSpells = 1

#    Lan.AutoLearn.Riding
#        Description: Learn the riding skills (including Cold Weather Flying) for free when the level allows.
#        Default:     1
Lan.AutoLearn.Riding = 1

#    Lan.AutoLearn.RidingFromLevel1
#        Description: With Lan.AutoLearn.Riding, learn every riding skill right away at any level, so the
#                     mounts can be used from level 1 (flying still only works where the game allows it).
#        Default:     1
Lan.AutoLearn.RidingFromLevel1 = 1

#    Lan.AllFlightPaths
#        Description: Every character knows all flight paths of its faction (and the neutral ones) on login.
#        Default:     1
Lan.AllFlightPaths = 1

###################################################################################################
# HUNTER PETS
#
#    Lan.HunterPets.AlwaysHappy
#        Description: Hunter pets always have full happiness, so they never need feeding.
#        Default:     1
Lan.HunterPets.AlwaysHappy = 1

###################################################################################################
# LAN PARTY AURA
#
#    Lan.PartyAura.Enable
#        Description: When enough real (non-bot) players are online, every real player gets a stat
#                     buff and bonus experience.
#        Default:     1
Lan.PartyAura.Enable = 1

#    Lan.PartyAura.MinPlayers
#        Description: Real players that have to be online.
#        Default:     3
Lan.PartyAura.MinPlayers = 3

#    Lan.PartyAura.Spell
#        Description: The buff. 20217 is Blessing of Kings (+10% stats).
#        Default:     20217
Lan.PartyAura.Spell = 20217

#    Lan.PartyAura.XPBonus
#        Description: Extra experience in percent.
#        Default:     10
Lan.PartyAura.XPBonus = 10

###################################################################################################
# VENDORS
#
#    Lan.Vendors.GearPrice
#        Description: Price in copper of every item at the gear vendors (starting areas and Dalaran)
#                     and the bag vendor. The profession vendors are always free.
#        Default:     10000 (1 gold)
Lan.Vendors.GearPrice = 10000

#    Lan.Vendors.FoodPrice
#        Description: Price in copper of every item at the Dalaran food vendor and the starting-area
#                     potions, food, elixirs and flasks vendor.
#        Default:     0 (free)
Lan.Vendors.FoodPrice = 0

#    Lan.Vendors.GemPrice / Lan.Vendors.MountPrice
#        Description: Price in copper at the starting-area gem vendor and at the mount vendors.
#        Default:     0 (free)
Lan.Vendors.GemPrice = 0
Lan.Vendors.MountPrice = 0

#    Lan.Vendors.BlockSellBack
#        Description: Items the LAN vendors sell for less than their vendor value can't be sold to vendors.
#        Default:     1
Lan.Vendors.BlockSellBack = 1

###################################################################################################
# ADVENTURE ROUTE
#
#    Lan.Route.Enable
#        Description: Pathfinder Maren's adventure route: four starting-area quests with heirlooms, then the
#                     Deadmines (level 20, mobs half as strong, level 70 loot), the Hellfire Ramparts (level
#                     60, then a level 80 vendor), Utgarde Keep, Azjol-Nerub and Drak'Tharon Keep (to level 80).
#                     Accepting a dungeon quest teleports the group inside.
#        Default:     1
Lan.Route.Enable = 1

#    Lan.Route.PassiveMobs
#        Description: Mobs in the five route dungeons don't attack on their own; they only fight back.
#        Default:     1
Lan.Route.PassiveMobs = 1

#    Lan.Route.KeeperDespawn
#        Description: Seconds Pathfinder Maren stays next to a defeated dungeon boss to take the quest.
#        Default:     3600
Lan.Route.KeeperDespawn = 3600

###################################################################################################
# BOTS (needs mod-playerbots)
#
#    Lan.RandomBots
#        Description: Number of random bots. -1 keeps Playerbots.MinRandomBots and
#                     Playerbots.MaxRandomBots from playerbots.conf.
#        Default:     100
Lan.RandomBots = 100

#    Lan.LfgFill.Enable
#        Description: Random bots fill the missing tank, healer and damage slots of dungeon finder
#                     queues with a real player, with the matching spec and gear.
#        Default:     1
Lan.LfgFill.Enable = 1

#    Lan.LfgFill.Delay
#        Description: Seconds in the queue before bots start to fill.
#        Default:     120
Lan.LfgFill.Delay = 120

#    Lan.HelperBots.Buff
#        Description: Bots in a group with a real player (helper bots) are stronger.
#        Default:     1
Lan.HelperBots.Buff = 1

#    Lan.HelperBots.DamageDone / Lan.HelperBots.HealingDone
#        Description: Extra damage and healing of helper bots, in percent.
#        Default:     25
Lan.HelperBots.DamageDone = 25
Lan.HelperBots.HealingDone = 25

#    Lan.HelperBots.DamageTakenReduction
#        Description: Less damage taken by helper bots, in percent.
#        Default:     20
Lan.HelperBots.DamageTakenReduction = 20

#    Lan.HelperBots.FreeForAllLoot
#        Description: Groups with helper bots use free-for-all loot, so bots never roll.
#        Default:     1
Lan.HelperBots.FreeForAllLoot = 1
